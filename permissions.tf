}

resource "discord_channel_permission" "moderator_only_everyone" {
  channel_id   = discord_text_channel.moderator_only.id
  type         = "role"
  overwrite_id = var.server_id
  deny         = data.discord_permission.ow_moderator_only_everyone.deny_bits
}

